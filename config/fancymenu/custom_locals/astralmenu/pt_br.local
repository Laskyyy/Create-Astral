astralmenu.creditsmenu.title = Créditos do Create: Astral
astralmenu.creditsmenu.buttons.contributors = Colaboradores
astralmenu.creditsmenu.buttons.developers = Desenvolvedores
astralmenu.creditsmenu.buttons.specialthanks = Agradecimentos Especiais
astralmenu.creditsmenu.packdevs.header = Desenvolvedores do Pack
astralmenu.creditsmenu.packdevs.description.laskyyy = Criador do Create: Astral e lobo residente.
astralmenu.creditsmenu.packdevs.description.ethanicuss = Mantém muitos dos mods de conteúdo feitos exclusivamente para o Astral, como o Astral Additions, e compôs parte da trilha sonora do modpack.
astralmenu.creditsmenu.packdevs.description.erdragh = Mantém muitos mods de correção feitos exclusivamente para o Create: Astral, para impedir que ele se desmanche pelas costuras.
astralmenu.creditsmenu.packdevs.description.winter = Compôs a maior parte da icônica trilha sonora original do Create: Astral.
astralmenu.creditsmenu.packdevs.description.shortman = Designer de menus, corretor de bugs, homem do monóculo. Também mantém o repositório no GitHub, num esforço constante para deixar o desenvolvimento o mais tranquilo possível.
astralmenu.creditsmenu.packdevs.description.trashpanda = O cérebro por trás de muitos tipos de receita únicos e efeitos chamativos do modpack, além de vários ajustes de compatibilidade de receitas no REI.
astralmenu.creditsmenu.contributors.header = Colaboradores Importantes
astralmenu.creditsmenu.contributors.programmers = Programadores
astralmenu.creditsmenu.contributors.composers = Compositores
astralmenu.creditsmenu.contributors.artists = Artistas
astralmenu.creditsmenu.contributors.translators = Tradutores
astralmenu.creditsmenu.contributors.other = Outros
astralmenu.creditsmenu.contributors.structures = Construtores de Estruturas
astralmenu.creditsmenu.specialthanks.header = Agradecimentos Extra Especiais
astralmenu.creditsmenu.specialthanks.description.lizard = Ex-desenvolvedor do Create: Astral, responsável por boa parte da progressão principal do pack. Hoje ele se dedica a projetos pessoais, e desejamos tudo de bom a ele!
astralmenu.creditsmenu.specialthanks.description.b0b = Carregou a comunidade do Astral nas costas como gerente do servidor do Discord. Já aposentado, o B0b teve um papel essencial na comunidade por muito tempo, e seremos eternamente gratos.
astralmenu.creditsmenu.specialthanks.betatesters = Testadores Beta
astralmenu.creditsmenu.specialthanks.backgroundcredit = Obrigado ao Senkou pelo fundo da tela de créditos!
astralmenu.creditsmenu.close = Fechar Créditos 

astralmenu.multiplayer_error_message.line1 = Se der erro ao entrar num servidor multijogador, tente entrar de novo antes de reportar como bug!
astralmenu.multiplayer_error_message.line2 = Se ainda não conseguir entrar, entre no Discord (o link fica no lado esquerdo do menu principal) e reporte no canal #bug-reports!

astralmenu.resourcepackmenu.resourcepack_help = <- Pacotes de recursos com problema? Clique aqui para corrigir!